#!/usr/bin/env bash
# Product code reaches main only via PR; staged Java must be Spotless-clean.
set -euo pipefail

branch="$(git branch --show-current)"
staged="$(git diff --cached --name-only --diff-filter=ACMR)"

if [[ "$branch" == "main" ]] && grep -qE '^(src/|pom\.xml$)' <<<"$staged"; then
  echo "[pre-commit] Product code (src/, pom.xml) cannot be committed to main. Use a task worktree + PR." >&2
  exit 1
fi

if grep -qE '\.java$' <<<"$staged"; then
  if ! ./mvnw -q -B spotless:check >/dev/null 2>&1; then
    echo "[pre-commit] Formatting violations. Run: ./mvnw -q -B spotless:apply" >&2
    exit 1
  fi
fi
